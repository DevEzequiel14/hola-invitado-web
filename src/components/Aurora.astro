---
interface Props {
  dotSize?: number;
  spacing?: number;
  duration?: number;
}

const { dotSize = 7, spacing = 14, duration = 56 } = Astro.props;
const hexSpacing = (spacing * 1.732).toFixed(2);
const halfGap = (spacing / 2).toFixed(2);
const halfHex = ((spacing * 1.732) / 2).toFixed(2);
---

<div
  class="aurora"
  aria-hidden="true"
  style={`--dot: ${dotSize}px; --gap: ${spacing}px; --hex: ${hexSpacing}px; --half-gap: ${halfGap}px; --half-hex: ${halfHex}px; --dur: ${duration}s;`}
></div>

<style>
  .aurora {
    position: fixed;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
    background-color: #1a1512;
    background-image:
      radial-gradient(circle at 50% 50%, transparent 1.5px, #1a1512 0 var(--dot), transparent var(--dot)),
      radial-gradient(circle at 50% 50%, transparent 1.5px, #1a1512 0 var(--dot), transparent var(--dot)),
      radial-gradient(circle at 50% 50%, rgba(166, 61, 77, 0.34), transparent 58%),
      radial-gradient(circle at 50% 50%, rgba(80, 58, 36, 0.26), transparent 62%),
      radial-gradient(circle at 50% 50%, rgba(224, 192, 122, 0.2), transparent 64%),
      radial-gradient(ellipse at 50% 50%, rgba(26, 21, 18, 0.42), transparent 70%);
    background-size:
      var(--gap) var(--hex),
      var(--gap) var(--hex),
      200% 200%,
      200% 200%,
      200% 200%,
      200% var(--hex);
    background-position:
      0 0,
      var(--half-gap) var(--half-hex),
      18% 12%,
      72% 68%,
      48% 40%,
      50% 0;
    animation: dots-drift var(--dur) linear infinite;
  }

  @keyframes dots-drift {
    to {
      background-position:
        0 0,
        var(--half-gap) var(--half-hex),
        62% 58%,
        28% 22%,
        70% 76%,
        50% var(--hex);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .aurora {
      animation: none;
    }
  }
</style>
