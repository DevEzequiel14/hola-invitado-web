---
interface Props {
  duration?: number;
}

const { duration = 56 } = Astro.props;
---

<div class="aurora" aria-hidden="true" style={`--dur: ${duration}s;`}></div>

<style>
  .aurora {
    position: fixed;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
    background-color: #1a1512;
    background-image:
      radial-gradient(ellipse at 22% 18%, rgba(166, 61, 77, 0.3), transparent 52%),
      radial-gradient(ellipse at 78% 72%, rgba(80, 58, 36, 0.34), transparent 58%),
      radial-gradient(ellipse at 50% 42%, rgba(224, 192, 122, 0.14), transparent 55%),
      radial-gradient(ellipse at 50% 100%, rgba(26, 21, 18, 0.72), transparent 48%);
    background-size: 140% 140%;
    background-position:
      18% 12%,
      72% 68%,
      48% 40%,
      50% 100%;
    animation: night-drift var(--dur) ease-in-out infinite alternate;
  }

  @keyframes night-drift {
    to {
      background-position:
        62% 38%,
        28% 22%,
        70% 58%,
        50% 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .aurora {
      animation: none;
    }
  }
</style>
