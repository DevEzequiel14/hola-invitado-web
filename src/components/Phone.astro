---
interface Props {
  href: string;
  src: string;
  alt: string;
  label: string;
  name: string;
  featured?: boolean;
  fit?: "cover" | "contain";
  bridge?: "from" | "to" | "in";
}

const { href, src, alt, label, name, featured = false, fit = "cover", bridge } = Astro.props;
---

<a
  class:list={[
    "phone",
    { "phone-hero": featured, "phone-contain": fit === "contain" },
    bridge ? `phone-bridge-${bridge}` : "",
  ]}
  href={href}
>
  <span class="phone-shell">
    <span class="phone-island" aria-hidden="true"></span>
    <img src={src} alt={alt} width="390" height="804" />
  </span>
  <span class="phone-meta">
    <strong>{label}</strong>
    <span>{name}</span>
  </span>
</a>
