---
import MockRsvp from "../components/MockRsvp.astro";
import InviteLayout from "../layouts/InviteLayout.astro";
import { quince } from "../data/demos";
import { waMessages } from "../data/site";
import { whatsappUrl } from "../lib/whatsapp";
import "../styles/quince.css";

const title = `${quince.honoree} — ${quince.headline} (muestra)`;
const description = "Muestra de invitación de quince. Datos inventados. No se guarda ninguna confirmación.";
---

<InviteLayout
  title={title}
  description={description}
  wantHref={whatsappUrl(waMessages.quince)}
  themeColor="#FF80AB"
  fonts="https://fonts.googleapis.com/css2?family=Gloock&family=Karla:wght@400;700&display=swap"
>
  <article class="invite-ticket quince-skin">
    <main id="contenido">
      <header>
        <h1>{quince.honoree}</h1>
        <p>{quince.headline}</p>
      </header>
      <section>
        <h2>El gran día</h2>
        <p>{quince.lead}</p>
        <p><b>{quince.dateLabel}</b><br />{quince.timeLabel}</p>
        <p>{quince.venue}<br />{quince.address}</p>
        <p>{quince.hosts}</p>
      </section>
      <section>
        <h2>Confirmá</h2>
        <MockRsvp />
        <p style="margin-top:1rem">
          <a class="btn" href={whatsappUrl(waMessages.quince)}>Quiero una así</a>
        </p>
      </section>
      <footer>
        <p>{quince.closing}</p>
        <p><a href="/">HolaInvitado</a></p>
      </footer>
    </main>
  </article>
</InviteLayout>
