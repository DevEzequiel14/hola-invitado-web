---
import SampleBanner from "../components/SampleBanner.astro";
import MockRsvp from "../components/MockRsvp.astro";
import RootLayout from "../layouts/RootLayout.astro";
import { casamiento } from "../data/demos";
import { waMessages } from "../data/site";
import { whatsappUrl } from "../lib/whatsapp";
import "../styles/sample.css";
import "../styles/casamiento.css";

const title = `${casamiento.honoree} — ${casamiento.headline} (muestra)`;
const description = "Muestra de invitación de casamiento. Datos inventados. No se guarda ninguna confirmación.";
---

<RootLayout title={title} description={description} themeColor="#4d5f4a">
  <link
    slot="fonts"
    href="https://fonts.googleapis.com/css2?family=Source+Serif+4:opsz,wght@8..60,600;8..60,700&family=Red+Hat+Text:ital,wght@0,400;0,700;1,400&display=swap"
    rel="stylesheet"
  />
  <SampleBanner wantHref={whatsappUrl(waMessages.casamiento)} />
  <div class="casa-page">
    <main id="contenido">
      <header class="casa-hero">
        <p class="casa-mono">C & T</p>
        <h1>{casamiento.honoree}</h1>
        <p>{casamiento.headline}</p>
      </header>
      <section class="casa-section">
        <h2>El día</h2>
        <p>{casamiento.lead}</p>
        <p><b>{casamiento.dateLabel}</b><br />{casamiento.timeLabel}</p>
        <p>{casamiento.venue}<br />{casamiento.address}</p>
        <p>{casamiento.hosts}</p>
      </section>
      <section class="casa-section">
        <h2>Confirmación</h2>
        <MockRsvp />
        <p style="margin-top:1rem">
          <a class="btn" href={whatsappUrl(waMessages.casamiento)}>Quiero una así</a>
        </p>
      </section>
      <footer class="casa-foot">
        <p>{casamiento.closing}</p>
        <p><a href="/">HolaInvitado</a></p>
      </footer>
    </main>
  </div>
</RootLayout>
