---
import MockRsvp from "../components/MockRsvp.astro";
import InviteLayout from "../layouts/InviteLayout.astro";
import { uno } from "../data/demos";
import { waMessages } from "../data/site";
import { whatsappUrl } from "../lib/whatsapp";
import "../styles/uno.css";

const title = `${uno.honoree} — ${uno.headline} (muestra)`;
const description = "Muestra de invitación infantil. Datos inventados. No se guarda ninguna confirmación.";
---

<InviteLayout
  title={title}
  description={description}
  wantHref={whatsappUrl(waMessages.uno)}
  themeColor="#FF6D00"
  fonts="https://fonts.googleapis.com/css2?family=Grandstander:wght@700;800&family=Karla:wght@400;700&display=swap"
>
  <article class="invite-ticket uno-skin">
    <main id="contenido">
      <header>
        <h1>{uno.honoree}</h1>
        <p>{uno.headline}</p>
      </header>
      <section>
        <h2>El gran día</h2>
        <p>{uno.lead}</p>
        <p><b>{uno.dateLabel}</b> · {uno.timeLabel}</p>
        <p>{uno.venue}<br />{uno.address}</p>
        <p>{uno.hosts}</p>
      </section>
      <section>
        <h2>¿Venís?</h2>
        <MockRsvp />
        <p style="margin-top:1rem">
          <a class="btn" href={whatsappUrl(waMessages.uno)}>Quiero una así</a>
        </p>
      </section>
      <footer>
        <p>{uno.closing}</p>
        <p><a href="/">HolaInvitado</a></p>
      </footer>
    </main>
  </article>
</InviteLayout>
