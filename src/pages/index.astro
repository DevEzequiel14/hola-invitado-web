---
import { cardFeatures, faqs, plans, processSteps, waMessages } from "../data/site";
import { event as giuliano } from "../events/giuliano1-k8n2/event";
import { event as casamiento } from "../events/sofiamateo-m4q7/event";
import { event as quince } from "../events/valentina15-n4w8/event";
import { whatsappUrl } from "../lib/whatsapp";
import Phone from "../components/Phone.astro";
import BrandLayout from "../layouts/BrandLayout.astro";

const versoParts = cardFeatures.columns.flatMap((column, i) =>
  i === 0 ? [{ kind: "stub" as const, column }] : [{ kind: "perf" as const }, { kind: "stub" as const, column }],
);
---

<BrandLayout>
  <main id="contenido">
    <section class="hero">
      <article class="hero-ticket">
        <header class="hero-stub">
          <a class="mark" href="/">Hola<span>Invitado</span></a>
        </header>
        <div class="ticket-perf ticket-perf-x" aria-hidden="true"></div>
        <div class="ticket-body">
          <h1 data-hand="title">Invitación digital para tu fiesta.</h1>
          <p data-hand="lead">Casamiento, quince o cumple. Un link: la recorren y confirman si van.</p>
          <div class="hero-actions" data-hand="stamps">
            <a class="btn btn-blue" href={whatsappUrl(waMessages.general)}>Contactame</a>
            <a class="btn btn-ghost" href="#tarjetas">Ver las fiestas</a>
          </div>
        </div>
        <div class="ticket-perf ticket-perf-y" aria-hidden="true"></div>
        <Phone
          featured
          href={`/${casamiento.slug}`}
          src="/brand/phones/casamiento.webp"
          alt="La invitación de Sofía y Mateo abierta en un celular"
          label="Así se abre"
          name="Sofía y Mateo"
        />
      </article>
    </section>

    <section class="band band-open band-gap" id="tarjetas" aria-labelledby="tarjetas-titulo">
      <h2 id="tarjetas-titulo">Tres fiestas para abrir.</h2>
      <p>Son invitaciones reales. Entrá y recorrelas.</p>
      <div class="phone-line">
        <Phone
          href={`/${casamiento.slug}`}
          src="/brand/phones/casamiento.webp"
          alt="Invitación de casamiento de Sofía y Mateo en un celular"
          label="Casamiento"
          name="Sofía y Mateo"
        />
        <Phone
          href={`/${quince.slug}`}
          src="/brand/phones/quince.webp"
          alt="Invitación de quince de Valentina en un celular"
          label="Quince"
          name="Valentina"
        />
        <Phone
          fit="contain"
          href={`/${giuliano.slug}`}
          src="/brand/phones/giuliano.webp"
          alt="Invitación de cumple de Giuliano en un celular"
          label="Cumple"
          name="Giuliano"
        />
      </div>
    </section>

    <section class="band band-open" id="encargo" aria-labelledby="encargo-titulo">
      <h2 id="encargo-titulo">Cómo es el encargo.</h2>
      <p>Hablamos por WhatsApp. Con dos semanas alcanza para una Esencial.</p>
      <div class="tears">
        {
          processSteps.map((step) => (
            <p class="tear">
              {step.name}
              <span>{step.detail}</span>
            </p>
          ))
        }
      </div>
    </section>

    <section class="band band-open" id="funciones" aria-labelledby="funciones-titulo">
      <h2 id="funciones-titulo">Qué puede llevar.</h2>
      <p>{cardFeatures.lead}</p>
      <article class="verso">
        {
          versoParts.map((part) =>
            part.kind === "perf" ? (
              <div class="ticket-perf" aria-hidden="true"></div>
            ) : (
              <div class="verso-stub">
                <ul class="verso-list">
                  {part.column.map((item) => (
                    <li class:list={{ "is-core": "core" in item && item.core }}>
                      <strong>{item.name}</strong>
                      {"detail" in item && item.detail ? <p>{item.detail}</p> : null}
                    </li>
                  ))}
                </ul>
              </div>
            ),
          )
        }
      </article>
    </section>

    <section class="band band-open" id="planes" aria-labelledby="planes-titulo">
      <h2 id="planes-titulo">Dos formas.</h2>
      <p>La diferencia es el alcance. El precio lo vemos por WhatsApp.</p>
      <article class="plan-ticket">
        <div class="plan">
          <h3>{plans.esencial.name}</h3>
          <p>{plans.esencial.lead}</p>
          <ul>
            {plans.esencial.includes.map((item) => <li>{item}</li>)}
          </ul>
          <a class="btn btn-gold" href={whatsappUrl(waMessages.esencial)}>Consultar Esencial</a>
        </div>
        <div class="ticket-perf" aria-hidden="true"></div>
        <div class="plan">
          <h3>{plans.premium.name}</h3>
          <p>{plans.premium.lead}</p>
          <ul>
            {plans.premium.includes.map((item) => <li>{item}</li>)}
          </ul>
          <a class="btn btn-blue" href={whatsappUrl(waMessages.premium)}>Consultar Premium</a>
        </div>
      </article>
    </section>

    <section class="band" aria-labelledby="preguntas">
      <h2 id="preguntas">Preguntas que ya me hicieron.</h2>
      <div class="faq">
        {
          faqs.map((item) => (
            <details>
              <summary>{item.q}</summary>
              <p>{item.a}</p>
            </details>
          ))
        }
      </div>
    </section>

    <section class="close" aria-labelledby="cierre">
      <article class="ticket">
        <h2 id="cierre">Contame de tu fiesta.</h2>
        <p>Escribime. Armamos la invitación, te paso el link y listo.</p>
        <a class="btn btn-pink" href={whatsappUrl(waMessages.general)}>Contactame</a>
      </article>
    </section>
  </main>
  <script>
    import { playBrandMotion } from "../scripts/brand-motion";
    playBrandMotion();
  </script>
</BrandLayout>
