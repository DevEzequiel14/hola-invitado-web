---
import { brand, instagram, waMessages } from "../data/site";
import { whatsappUrl } from "../lib/whatsapp";
import Aurora from "../components/Aurora.astro";
import RootLayout from "./RootLayout.astro";
import "../styles/brand.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${brand} — invitaciones web con lista de confirmados`,
  description = "Invitaciones web para Jujuy y el NOA. Los invitados confirman en el link y vos ves la lista. Hablamos por WhatsApp.",
} = Astro.props;

const igHref = instagram
  ? instagram.startsWith("http")
    ? instagram
    : `https://instagram.com/${instagram.replace(/^@/, "")}`
  : "";
---

<RootLayout title={title} description={description} themeColor="#0A0A0A">
  <link
    slot="fonts"
    href="https://fonts.googleapis.com/css2?family=Karla:ital,wght@0,400;0,700;1,400&family=Saira+Condensed:wght@600;700&display=swap"
    rel="stylesheet"
  />
  <Aurora />
  <div class="brand-shell">
    <slot />
    <footer class="site-foot">
      <p class="site-foot-mark">{brand}</p>
      <p>Invitaciones web para Jujuy y el NOA. Un link. Una lista. Sin grupo eterno.</p>
      <div class="site-foot-links">
        <a href={whatsappUrl(waMessages.general)}>WhatsApp</a>
        {
          igHref ? (
            <a href={igHref} rel="noreferrer" target="_blank">
              Instagram
            </a>
          ) : (
            <span class="gap" title="El handle se carga cuando lo pases">
              Instagram
            </span>
          )
        }
      </div>
    </footer>
  </div>
</RootLayout>
