---
import { brand, instagram, waMessages } from "../data/site";
import { whatsappUrl } from "../lib/whatsapp";
import Aurora from "../components/Aurora.astro";
import RootLayout from "./RootLayout.astro";
import "../styles/brand.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${brand} — invitaciones digitales para tu fiesta`,
  description = "Invitación digital para casamiento, quince o cumple. Los invitados recorren la tarjeta y confirman si van. Pedí presupuesto por WhatsApp.",
} = Astro.props;

const igHref = instagram
  ? instagram.startsWith("http")
    ? instagram
    : `https://instagram.com/${instagram.replace(/^@/, "")}`
  : "";
---

<RootLayout title={title} description={description} themeColor="#0C0A09">
  <link
    slot="fonts"
    href="https://fonts.googleapis.com/css2?family=Grandstander:wght@700;800&family=Karla:ital,wght@0,400;0,700;1,400&family=Saira+Condensed:wght@600;700&display=swap"
    rel="stylesheet"
  />
  <Aurora />
  <div class="brand-shell">
    <slot />
    <footer class="site-foot">
      <p class="site-foot-mark">{brand}</p>
      <div class="site-foot-links">
        <a href={whatsappUrl(waMessages.general)}>WhatsApp</a>
        {
          igHref ? (
            <a href={igHref} rel="noreferrer" target="_blank">
              Instagram
            </a>
          ) : null
        }
      </div>
      <p class="site-foot-copy">© 2026 {brand}. Todos los derechos reservados.</p>
    </footer>
  </div>
</RootLayout>
