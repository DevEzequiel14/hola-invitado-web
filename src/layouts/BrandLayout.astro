---
import { brand, instagram, waMessages } from "../data/site";
import { whatsappUrl } from "../lib/whatsapp";
import Aurora from "../components/Aurora.astro";
import BrandMark from "../components/BrandMark.astro";
import RootLayout from "./RootLayout.astro";
import "../styles/brand.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${brand} — invitaciones digitales para tu fiesta`,
  description = "Invitación digital para casamiento, quince o cumple. Los invitados recorren la tarjeta y confirman si van. Pedí presupuesto por WhatsApp.",
} = Astro.props;

const igHref = instagram
  ? instagram.startsWith("http")
    ? instagram
    : `https://instagram.com/${instagram.replace(/^@/, "")}`
  : "";
---

<RootLayout title={title} description={description} themeColor="#1A1512">
  <link
    slot="fonts"
    href="https://fonts.googleapis.com/css2?family=Karla:ital,wght@0,400;0,700;1,400&family=Saira+Condensed:wght@600;700&display=swap"
    rel="stylesheet"
  />
  <script is:inline slot="head">
    if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      document.documentElement.classList.add("brand-motion");
      window.setTimeout(function () {
        document.documentElement.classList.add("is-ready");
      }, 2000);
    }
  </script>
  <Aurora />
  <div class="brand-shell">
    <slot />
    <footer class="site-foot">
      <p class="site-foot-mark"><BrandMark />{brand}</p>
      <div class="site-foot-links">
        <a href={whatsappUrl(waMessages.general)}>WhatsApp</a>
        {
          igHref ? (
            <a href={igHref} rel="noreferrer" target="_blank">
              Instagram
            </a>
          ) : null
        }
      </div>
      <p class="site-foot-copy">© 2026 {brand}. Todos los derechos reservados.</p>
    </footer>
    <a class="wa-fab" href={whatsappUrl(waMessages.general)} aria-label="Escribime por WhatsApp">
      <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path
          d="M12.04 2C6.58 2 2.15 6.4 2.15 11.83c0 1.74.46 3.44 1.33 4.94L2 22l5.38-1.41a10.1 10.1 0 0 0 4.66 1.12h.01c5.46 0 9.89-4.4 9.89-9.83C21.94 6.4 17.5 2 12.04 2Zm5.72 13.98c-.24.68-1.4 1.25-1.94 1.33-.5.07-1.13.1-1.83-.11-.42-.14-.97-.32-1.67-.62-2.94-1.27-4.86-4.23-5.01-4.43-.15-.2-1.25-1.66-1.25-3.17 0-1.5.79-2.24 1.07-2.55.28-.3.61-.38.81-.38h.58c.19 0 .44-.07.69.53.24.58.82 2 .89 2.15.07.15.12.32.02.52-.09.2-.14.32-.28.5-.14.17-.3.39-.42.52-.14.15-.28.3-.12.59.15.28.68 1.12 1.46 1.82 1 .9 1.85 1.18 2.14 1.32.28.14.45.12.61-.07.17-.2.7-.81.88-1.09.19-.28.37-.23.62-.14.24.1 1.55.73 1.82.86.26.14.44.2.5.31.07.11.07.64-.17 1.32Z"
        ></path>
      </svg>
    </a>
  </div>
</RootLayout>
