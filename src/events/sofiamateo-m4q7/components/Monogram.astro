---
interface Props {
	class?: string;
}

const className = Astro.props.class ?? 'monogram';
---

<svg class={className} viewBox="0 0 120 120" aria-hidden="true">
	<circle cx="60" cy="60" r="54" fill="none" stroke="#C4A574" stroke-width="1.2"></circle>
	<circle cx="60" cy="60" r="48" fill="none" stroke="#A6864A" stroke-width="0.6"></circle>
	<path
		d="M22 78c8-28 22-48 38-52 10 18 4 38-8 48 16-6 34-4 44 14"
		fill="none"
		stroke="#7A9A86"
		stroke-width="1.4"
		stroke-linecap="round"
	></path>
	<path
		d="M86 36c8 6 14 16 12 28"
		fill="none"
		stroke="#6B7F5A"
		stroke-width="1.2"
		stroke-linecap="round"
	></path>
	<text
		x="60"
		y="72"
		text-anchor="middle"
		font-family="Fraunces, Times New Roman, serif"
		font-size="28"
		fill="#2C3329"
		letter-spacing="1">S&amp;M</text>
</svg>
