---
interface Props {
	name: 'rings' | 'glass' | 'plate' | 'music' | 'moon';
}

const { name } = Astro.props;
---

{
	name === 'rings' && (
		<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
			<circle cx="9" cy="12" r="4.5"></circle>
			<circle cx="15" cy="12" r="4.5"></circle>
		</svg>
	)
}
{
	name === 'glass' && (
		<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
			<path d="M8 4h8l-1.2 8.5a4.8 4.8 0 0 1-9.6 0L8 4Z"></path>
			<path d="M12 17v3M9 20h6"></path>
		</svg>
	)
}
{
	name === 'plate' && (
		<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
			<circle cx="12" cy="12" r="7"></circle>
			<circle cx="12" cy="12" r="3"></circle>
		</svg>
	)
}
{
	name === 'music' && (
		<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
			<path d="M9 18V6l10-2v12"></path>
			<circle cx="7" cy="18" r="2.4"></circle>
			<circle cx="17" cy="16" r="2.4"></circle>
		</svg>
	)
}
{
	name === 'moon' && (
		<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
			<path d="M15 4.5A7.5 7.5 0 1 0 19.5 14 6 6 0 0 1 15 4.5Z"></path>
		</svg>
	)
}
