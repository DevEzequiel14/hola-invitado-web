---
import { existsSync } from "node:fs";
import path from "node:path";
import EventLayout from "../../layouts/EventLayout.astro";
import Overlay from "./components/Overlay.astro";
import AudioToggle from "./components/AudioToggle.astro";
import Hero from "./components/Hero.astro";
import Carta from "./components/Carta.astro";
import GranDia from "./components/GranDia.astro";
import Noche from "./components/Noche.astro";
import DressCode from "./components/DressCode.astro";
import Gallery from "./components/Gallery.astro";
import ComoLlegar from "./components/ComoLlegar.astro";
import Practical from "./components/Practical.astro";
import Gifts from "./components/Gifts.astro";
import RsvpForm from "./components/RsvpForm.astro";
import SiteFooter from "./components/SiteFooter.astro";
import { quince } from "./data/quince";
import { event, pageDescription, pageTitle, shareImageAlt } from "./event";
import "./styles/global.css";

const audioAvailable = existsSync(
  path.join(process.cwd(), "public", "events", quince.slug, quince.music.filename),
);
---

<EventLayout
  title={pageTitle}
  description={pageDescription}
  image={event.ogImage}
  shareImageAlt={shareImageAlt}
  siteName={event.siteName}
  themeColor={event.themeColor}
  fonts={event.fonts}
  favicon={event.favicon}
  indexable={event.indexable}
  audioAvailable={audioAvailable}
>
  <script is:inline slot="head">
    try {
      if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        document.documentElement.classList.add("has-motion");
      }
    } catch {}
  </script>
  <Overlay audioAvailable={audioAvailable} />
  {audioAvailable ? <AudioToggle audioAvailable /> : null}
  <div class="shell">
    <main id="contenido">
      <Hero />
      <div class="sheet">
        <div class="invite-column">
          <Carta />
          <GranDia />
          <Noche />
          <DressCode />
        </div>
      </div>
      <Gallery />
      <div class="sheet sheet-end">
        <div class="invite-column">
          <ComoLlegar />
          <Practical />
          <Gifts />
          <RsvpForm />
        </div>
        <SiteFooter />
      </div>
    </main>
  </div>
  <noscript>
    <style>
      .overlay {
        display: none !important;
      }
      .hero .bulb,
      .hero .butterfly,
      .hero .bloom {
        animation-play-state: running !important;
      }
      .audio-toggle {
        opacity: 1 !important;
        transform: none !important;
      }
    </style>
  </noscript>
</EventLayout>

<script>
  import { bootInvitation } from "./scripts/client";
  bootInvitation();
</script>
