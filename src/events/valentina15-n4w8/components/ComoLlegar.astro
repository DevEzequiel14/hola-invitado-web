---
import Divider from './decor/Divider.astro';
import { quince, maps } from '../data/quince';
---

<section class="section" id="como-llegar" aria-labelledby="maps-title">
  <h2 class="section-title" id="maps-title">{quince.copy.mapsTitle}</h2>
  <p class="lede">{quince.copy.mapsBody}</p>
  <p class="place-line">
    <strong>{quince.venue}</strong>
    {quince.address}
  </p>
  <div class="map-actions">
    <a class="btn btn-primary" href={maps.google} target="_blank" rel="noreferrer">
      Abrir en Google Maps
    </a>
  </div>
</section>
<Divider />
