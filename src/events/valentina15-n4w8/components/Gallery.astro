---
import { Image } from 'astro:assets';
import vestido from '../assets/01-vestido.jpg';
import ramo from '../assets/02-ramo.jpg';
import luces from '../assets/03-luces.jpg';
import jardin from '../assets/04-jardin.jpg';
import mesa from '../assets/05-mesa.jpg';
import Divider from './decor/Divider.astro';
import { quince } from '../data/quince';

const files = [vestido, ramo, luces, jardin, mesa];
const slides = quince.photos.gallery.map((item, index) => ({
  ...item,
  src: files[index],
}));
---

<section class="section section-gallery" id="fotos" aria-labelledby="fotos-title">
  <h2 class="section-title" id="fotos-title">{quince.copy.galleryTitle}</h2>
  <div class="gallery-wrap" data-gallery>
    <div class="gallery-track" data-gallery-track tabindex="0" aria-label="Carrusel de fotos">
      {
        slides.map((slide, index) => (
          <figure class="gallery-slide">
            <Image
              src={slide.src}
              alt={slide.alt}
              widths={[360, 720, 1080, 1400]}
              sizes="(min-width: 900px) 36vw, 82vw"
              loading={index === 0 ? 'eager' : 'lazy'}
              quality={80}
            />
          </figure>
        ))
      }
    </div>
    <div class="gallery-nav">
      <div class="dots" data-gallery-dots>
        {
          slides.map((_, index) => (
            <button type="button" aria-label={`Ver foto ${index + 1}`} aria-current={index === 0 ? 'true' : 'false'}></button>
          ))
        }
      </div>
      <div class="gallery-arrows">
        <button class="icon-btn" type="button" data-gallery-prev aria-label="Foto anterior">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M15 5 L8 12 L15 19" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </button>
        <button class="icon-btn" type="button" data-gallery-next aria-label="Foto siguiente">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M9 5 L16 12 L9 19" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>
</section>
<Divider />
