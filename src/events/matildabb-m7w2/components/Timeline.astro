---
import { shower } from '../data/shower';
import Divider from './Divider.astro';
import Icon from './Icon.astro';
---

<section class="section" id="dia" aria-labelledby="dia-title">
	<Divider />
	<h2 class="section-title" id="dia-title">La tarde</h2>
	<p class="lede">Del primer té a la última mariposa.</p>
	<ol class="timeline">
		{
			shower.timeline.map((item) => (
				<li class="timeline-item">
					<div class="timeline-icon">
						<Icon name={item.icon} />
					</div>
					<div>
						<p class="timeline-time">{item.time}</p>
						<p class="timeline-label">{item.label}</p>
					</div>
				</li>
			))
		}
	</ol>
</section>
