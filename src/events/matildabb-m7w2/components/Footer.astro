---
import { shower } from '../data/shower';
import Divider from './Divider.astro';
---

<footer class="footer">
	<Divider />
	<p class="hosts">Los invitan<br /><strong>{shower.invitedBy}</strong></p>
	<p class="hashtag">{shower.honoree.firstName}</p>
	<p class="closing">{shower.closing}</p>
	<p class="brand"><a href="/" aria-label="Volver a HolaInvitado">{shower.brand}</a></p>
</footer>
