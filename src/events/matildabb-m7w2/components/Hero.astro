---
import { Image } from 'astro:assets';
import { shower } from '../data/shower';

const covers = import.meta.glob<ImageMetadata>('../assets/portada.webp', {
	eager: true,
	import: 'default',
});
const butterflies = import.meta.glob<ImageMetadata>('../assets/bf-*.webp', {
	eager: true,
	import: 'default',
});
const portada = Object.values(covers)[0];
const bfPlates = Object.values(butterflies);
---

<header class:list={['hero', !portada && 'is-plain']} id="inicio">
	{
		portada && (
			<Image
				src={portada}
				alt={shower.heroAlt}
				class="hero-photo"
				widths={[512, 768, 1024]}
				sizes="100vw"
				quality={88}
				format="webp"
				priority
			/>
		)
	}
	<div class="hero-shade"></div>
	<div class="hero-wash" aria-hidden="true"></div>
	<div class="hero-butterflies" aria-hidden="true">
		{
			bfPlates.map((src, i) => (
				<img class={`hero-bf hb-${i + 1}`} src={src.src} alt="" width="120" height="120" />
			))
		}
	</div>
	<div class="hero-inner">
		<h1 class="script hero-reveal">{shower.honoree.firstName}</h1>
		<p class="hero-secondary hero-reveal">{shower.kicker}</p>
		<div class="hero-band hero-reveal" aria-hidden="true"></div>
		<p class="hero-phrase hero-reveal">{shower.phrase}</p>
		<p class="hero-date hero-reveal">{shower.date.label}</p>
		<a class="btn btn-primary hero-reveal" href="#confirmar">Confirmar asistencia</a>
	</div>
</header>
