<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  const gallery = document.querySelector("[data-gallery]");
  if (gallery instanceof HTMLElement) {
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      gallery.classList.remove("gallery--pending");
    } else {
      gallery.classList.add("gallery--pending");
      requestAnimationFrame(() => {
        gsap.registerPlugin(ScrollTrigger);

        const title = gallery.querySelector(".section-title");
        const rows = gallery.querySelectorAll(".gallery-row");
        const expected = (title ? 1 : 0) + rows.length;
        const finished = new Set<string>();
        const done = (id: string) => {
          finished.add(id);
          if (finished.size >= expected) gallery.classList.remove("gallery--pending");
        };

        if (expected === 0) {
          gallery.classList.remove("gallery--pending");
          return;
        }

        if (title) {
          gsap.to(title, {
            opacity: 1,
            y: 0,
            duration: 0.55,
            ease: "power2.out",
            onComplete: () => done("title"),
            scrollTrigger: {
              trigger: title,
              start: "top 90%",
              once: true,
            },
          });
        }

        rows.forEach((row, index) => {
          const photos = row.querySelectorAll("figure");
          gsap.to(photos, {
            opacity: 1,
            y: 0,
            duration: 0.7,
            ease: "power2.out",
            stagger: photos.length > 1 ? 0.1 : 0,
            onComplete: () => done(`row-${index}`),
            scrollTrigger: {
              trigger: row,
              start: "top 88%",
              once: true,
            },
          });
        });
      });
    }
  }
</script>
