---
import { Image } from 'astro:assets';
import { party } from '../data/party';
import Monogram from './Monogram.astro';
import puerta from '../assets/puerta.webp';
---

<div class="overlay" data-overlay role="dialog" aria-modal="true" aria-labelledby="overlay-title">
	<div class="gate" aria-hidden="true">
		<Image
			src={puerta}
			alt=""
			class="gate-photo"
			widths={[480, 720, 960]}
			sizes="100vw"
			quality={82}
			format="webp"
		/>
		<div class="gate-shade"></div>
		<div class="gate-doors">
			<div class="gate-door gate-door-left" data-gate-left>
				<span class="gate-panel"></span>
				<span class="gate-sash gate-sash-a"></span>
				<span class="gate-sash gate-sash-b"></span>
				<span class="gate-handle"></span>
			</div>
			<div class="gate-door gate-door-right" data-gate-right>
				<span class="gate-panel"></span>
				<span class="gate-sash gate-sash-a"></span>
				<span class="gate-sash gate-sash-b"></span>
				<span class="gate-handle"></span>
			</div>
		</div>
		<div class="gate-arch">
			<span class="gate-arch-bar"></span>
		</div>
	</div>
	<div class="overlay-card" data-invite-open>
		<Monogram />
		<p class="overlay-kicker">{party.kicker}</p>
		<h1 class="script" id="overlay-title">{party.honoree.name}</h1>
		<div class="gold-line"></div>
		<p class="overlay-copy">{party.phrase}</p>
		<p class="overlay-welcome">Puerta de invitado · N.º 60</p>
		<div class="overlay-actions">
			<button class="btn btn-primary" type="button" data-open-invite>Abrir la puerta</button>
		</div>
	</div>
</div>
