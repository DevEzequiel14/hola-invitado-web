---
import { Image } from 'astro:assets';
import crest from '../assets/crest.webp';

interface Props {
	class?: string;
}

const className = Astro.props.class ?? 'monogram';
---

<span class={className}>
	<Image
		src={crest}
		alt=""
		widths={[96, 144, 192]}
		sizes="96px"
		quality={90}
		format="webp"
	/>
</span>
