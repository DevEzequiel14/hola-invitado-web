---
interface Props {
	name: 'cup' | 'spark' | 'gift' | 'cake' | 'heart' | 'wave';
}

const { name } = Astro.props;
---

{
	name === 'cup' && (
		<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
			<path d="M4.5 9h11v4.5a5.5 5.5 0 0 1-11 0V9Z" />
			<path d="M15.5 10.5h1.8a2.2 2.2 0 0 1 0 4.4h-2" />
			<path d="M3.5 20h13" />
			<path d="M8 3.5c-.8 1 .8 1.6 0 2.6M11.5 3.5c-.8 1 .8 1.6 0 2.6" />
		</svg>
	)
}
{
	name === 'spark' && (
		<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
			<path d="M12 3.5 13.8 9l5.7 1.8-5.7 1.8L12 18l-1.8-5.4L4.5 10.8 10.2 9 12 3.5Z" />
			<path d="M19 3.5v3M17.5 5h3" />
			<path d="M5.5 17.5v3M4 19h3" />
		</svg>
	)
}
{
	name === 'gift' && (
		<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
			<rect x="4" y="9.5" width="16" height="10.5" rx="1.5" />
			<path d="M3.5 9.5h17v-3h-17v3Z" />
			<path d="M12 6.5V20" />
			<path d="M12 6.5C10.5 3 7 3.5 7.5 5.5c.4 1.4 2.8 1 4.5 1Zm0 0c1.5-3.5 5-3 4.5-1-.4 1.4-2.8 1-4.5 1Z" />
		</svg>
	)
}
{
	name === 'cake' && (
		<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
			<path d="M4.5 20v-6.5a1.5 1.5 0 0 1 1.5-1.5h12a1.5 1.5 0 0 1 1.5 1.5V20" />
			<path d="M3.5 20h17" />
			<path d="M4.5 15.5c1.5 1.5 3 1.5 4 0s3-1.5 4 0 3 1.5 4 0 2-1 3-.5" />
			<path d="M12 12V8.5" />
			<path d="M12 7.5c-1.2-1-1.2-2.4 0-3.5 1.2 1.1 1.2 2.5 0 3.5Z" />
		</svg>
	)
}
{
	name === 'heart' && (
		<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
			<path d="M12 20s-7-4.4-7-9.2C5 7.6 7.2 5.8 9.4 5.8c1.3 0 2.4.6 2.6 1.6.2-1 1.3-1.6 2.6-1.6 2.2 0 4.4 1.8 4.4 5C19 15.6 12 20 12 20Z" />
		</svg>
	)
}
{
	name === 'wave' && (
		<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
			<path d="M3 14c2-3 4-3 6 0s4 3 6 0 4-3 6 0" />
			<path d="M3 18c2-3 4-3 6 0s4 3 6 0 4-3 6 0" />
		</svg>
	)
}
