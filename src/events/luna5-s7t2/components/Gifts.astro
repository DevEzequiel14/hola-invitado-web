---
import { party } from '../data/party';
import Divider from './Divider.astro';
import Icon from './Icon.astro';
---

<section class="section" id="regalos" aria-labelledby="regalos-title">
	<Divider />
	<h2 class="section-title" id="regalos-title">Mesa de regalos</h2>
	<div class="gift-box">
		<span class="gift-icon" aria-hidden="true"><Icon name="gift" /></span>
		<p class="lede tight">{party.gifts.intro}</p>
		<p>{party.gifts.detail}</p>
	</div>
</section>
