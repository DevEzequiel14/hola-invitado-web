---
import { party } from '../data/party';
import Divider from './Divider.astro';
---

<section class="section" id="dress-code" aria-labelledby="dress-title">
	<Divider />
	<h2 class="section-title" id="dress-title">{party.dressCode.title}</h2>
	<div class="dress-card">
		<p class="dress-name">{party.dressCode.name}</p>
		<p>{party.dressCode.text}</p>
		<ul class="swatches">
			{
				party.dressCode.swatches.map((swatch) => (
					<li class="swatch">
						<i style={`background:${swatch.hex}`}></i>
						{swatch.name}
					</li>
				))
			}
		</ul>
		<p class="note">{party.dressCode.note}</p>
	</div>
</section>
