---
interface Props {
	id: string;
	title: string;
	kind?: string;
	time: string;
	place: string;
	address: string;
	detail: string;
	maps: string;
}

const { id, title, kind, time, place, address, detail, maps } = Astro.props;
---

<section class="section" id={id} aria-labelledby={`${id}-title`}>
	<div class="place-card">
		<h2 class="section-title is-left" id={`${id}-title`}>{title}</h2>
		{kind && <p class="kicker">{kind}</p>}
		<p>{detail}</p>
		<div class="meta">
			<strong>{time}</strong>
			<span>{place}</span>
			<span>{address}</span>
		</div>
		<a class="btn btn-primary" href={maps} target="_blank" rel="noreferrer">Cómo llegar</a>
	</div>
</section>
