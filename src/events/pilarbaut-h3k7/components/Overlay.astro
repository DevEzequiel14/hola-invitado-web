---
import { baptism } from '../data/baptism';
import Monogram from './Monogram.astro';
---

<div class="overlay" data-overlay role="dialog" aria-modal="true" aria-labelledby="overlay-title">
	<img
		class="overlay-still"
		src={`/events/pilarbaut-h3k7/gallery/01-flores.webp`}
		alt=""
		aria-hidden="true"
		width="864"
		height="1152"
	/>
	<div class="envelope" aria-hidden="true">
		<div class="envelope-flap-wrap" data-envelope-flap>
			<span class="envelope-lining"></span>
			<span class="envelope-flap"></span>
		</div>
		<div class="envelope-pocket"></div>
	</div>
	<div class="overlay-card" data-invite-open>
		<Monogram />
		<p class="overlay-kicker">{baptism.kicker}</p>
		<h1 class="script" id="overlay-title">{baptism.honoree.firstName}</h1>
		<div class="gold-line"></div>
		<p class="overlay-copy">{baptism.phrase}</p>
		<p class="overlay-welcome">Abrí el sobre.</p>
		<div class="overlay-actions">
			<button class="btn btn-primary" type="button" data-open-invite>Abrir la invitación</button>
		</div>
	</div>
</div>
