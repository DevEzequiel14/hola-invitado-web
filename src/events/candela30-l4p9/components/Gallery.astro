---
import { Image } from 'astro:assets';
import swirl from '../assets/01-swirl.webp';
import rolls from '../assets/02-rolls.webp';
import flat from '../assets/03-flat.webp';
import wave from '../assets/04-wave.webp';
import satin from '../assets/05-satin.webp';
import { party } from '../data/party';
import Divider from './Divider.astro';

const photos = [swirl, rolls, flat, wave, satin];
---

<section class="section" id="fotos" aria-labelledby="fotos-title">
	<Divider />
	<h2 class="section-title" id="fotos-title">El print</h2>
	<p class="lede">Tela real: satén, terciopelo y el patrón de cerca.</p>
	<div class="gallery-track" data-gallery tabindex="0" aria-label="Fotos">
		{
			party.gallery.map((item, index) => (
				<figure class="slide">
					<Image
						src={photos[index]}
						alt={item.alt}
						widths={[700, 1080, 1400]}
						sizes="(min-width: 900px) 36vw, 86vw"
						quality={82}
					/>
				</figure>
			))
		}
	</div>
	<div class="dots" data-dots>
		{
			party.gallery.map((item, index) => (
				<button class:list={['dot', index === 0 && 'is-on']} type="button" aria-label={`Ver foto ${index + 1}: ${item.alt}`} data-dot={index}></button>
			))
		}
	</div>
</section>
