---
import { party } from '../data/party';
import Divider from './Divider.astro';
---

<section class="section" id="historia" aria-labelledby="historia-title">
	<Divider />
	<h2 class="section-title" id="historia-title">Su historia</h2>
	<p class="lede">Tres flashes de la que prende cada noche.</p>
	<ol class="story-list">
		{
			party.story.map((item, index) => (
				<li class="story-card">
					<p class="kicker">0{index + 1}</p>
					<h3>{item.title}</h3>
					<p>{item.text}</p>
				</li>
			))
		}
	</ol>
</section>
