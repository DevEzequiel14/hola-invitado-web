---
import { Image } from 'astro:assets';
import escudo from '../assets/01-escudo.webp';
import atardecer from '../assets/02-atardecer.webp';
import fachada from '../assets/03-fachada.webp';
import entrada from '../assets/04-entrada.webp';
import escudoTribuna from '../assets/05-escudo-tribuna.webp';
import { party } from '../data/party';
import Divider from './Divider.astro';

const photos = [escudo, atardecer, fachada, entrada, escudoTribuna];
---

<section class="section" id="fotos" aria-labelledby="fotos-title">
	<Divider />
	<h2 class="section-title" id="fotos-title">Azul y oro</h2>
	<p class="lede">La Bombonera, el escudo y la noche xeneize.</p>
	<div class="gallery-track" data-gallery tabindex="0" aria-label="Fotos">
		{
			party.gallery.map((item, index) => (
				<figure class="slide">
					<Image
						src={photos[index]}
						alt={item.alt}
						widths={[700, 1080, 1400]}
						sizes="(min-width: 900px) 36vw, 86vw"
						quality={82}
					/>
				</figure>
			))
		}
	</div>
	<div class="dots" data-dots>
		{
			party.gallery.map((item, index) => (
				<button class:list={['dot', index === 0 && 'is-on']} type="button" aria-label={`Ver foto ${index + 1}: ${item.alt}`} data-dot={index}></button>
			))
		}
	</div>
</section>
