# RSVP → Google Sheet (ver docs/rsvp-apps-script.gs)
RSVP_SHEET_WEBHOOK=
RSVP_SHEET_SECRET=

# Rate limit en /api/rsvp (Upstash Redis). Sin esto, en local no se limita.
# En Vercel de producción conviene cargarlo.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cloudflare Turnstile (opt-in si aparece spam). Ambos o ninguno.
# PUBLIC_ va al cliente; TURNSTILE_SECRET_KEY solo al server.
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
